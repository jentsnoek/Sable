{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sable",
  "version": "0.1.0",
  "identifier": "com.jentsnoek.sable",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sable",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 650,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
